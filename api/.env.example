PORT=3000
WEB_ORIGIN=http://localhost:4200,https://tourose.netlify.app

# OpenAgenda — gratuit (lecture seule). Créer un compte → https://openagenda.com/settings/apiKey
# Copier la clé PUBLIQUE (pas la secrète) :
OPENAGENDA_PUBLIC_KEY=

# IA TouRose (optionnel) — sans clé, le mode heuristique reste actif
# Compatible OpenAI / OpenRouter / Groq (via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
